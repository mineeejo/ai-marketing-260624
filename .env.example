# Supabase 프로젝트 설정 → API 메뉴에서 복사
# 로컬은 .env.local 에, 배포는 Vercel 환경변수에 등록하세요. (이 파일은 예시용)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 관리자 계정 ──────────────────────────────────────────────
# "아이디:비밀번호" 형태로, 콤마(,)로 구분해 최대 여러 명(예: 3명) 등록 가능.
# 관리자는 /admin 에서 로그인하며, 로그인하면 고객 후기의 모든 글을
# 비밀번호 없이 수정·삭제하고 답글을 달 수 있습니다.
# (아이디는 ':' , 계정 구분은 ',' 를 쓰므로 비밀번호에 ',' 는 넣지 마세요.)
ADMIN_USERS=bal:bal1234!,manager:changeme2,owner:changeme3

# 관리자 로그인 세션 서명용 비밀키. 아무한테도 노출 금지.
# 아래 명령으로 랜덤 생성 권장:  openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# (선택·레거시) 단일 관리자 마스터 비밀번호. ADMIN_USERS 를 쓰면 없어도 됩니다.
# ADMIN_PASSWORD=bal1234!
