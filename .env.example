# Supabase 프로젝트 설정 → API 메뉴에서 복사
# 로컬은 .env.local 에, 배포는 Vercel 환경변수에 등록하세요. (이 파일은 예시용)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 관리자 마스터 비밀번호 — 이 값을 후기 수정/삭제 비밀번호 칸에 입력하면
# 작성자와 상관없이 모든 후기를 수정/삭제할 수 있습니다. (관리자 전용, 외부 노출 금지)
# 숫자·영문 모두 가능하며 길이 제한 없음. 예시는 0113.
ADMIN_PASSWORD=0113
